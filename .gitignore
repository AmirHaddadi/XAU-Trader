# Compiled MQL5 binaries — build artifacts, not source
*.ex5
*.ex4

# MetaEditor/MetaTrader compile & runtime logs
*.log
MQL5/Experts/**/*.log
MQL5/Logs/

# Per-user runtime state written by the EA at runtime (not source)
MQL5/Files/XAUTrader/

# Ad-hoc debug screenshots dropped in the project root during testing
/Screenshot*.png

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Node/TypeScript workspace (apps/web, apps/bridge, packages/protocol)
node_modules/
dist/
.next/
*.tsbuildinfo

# Bridge runtime state — local SQLite journal/settings DB, not source
apps/bridge/data/

# Deployment-level secrets/config, never committed — see .env.example
.env
.env.local

# pkg/Windows-exe packaging output (Phase D) — out/ is the deliverable,
# .tmp/ is scratch (bundle intermediates, downloaded Node archives cache)
build/package-windows/out/
build/package-windows/.tmp/

# A loose copy of the built installer sometimes dropped at the repo root
# for Amir to grab and hand to the client — distribution is the GitHub
# Release asset, this is never meant to enter git history.
/XAUTrader-Setup-*.exe
