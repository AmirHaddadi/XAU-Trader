# Deployment-level config only — end-user preferences (theme, language, risk
# defaults, ...) live in the SQLite settings table via the web Settings tab,
# not here. See DELIVERY docs / plan for the split rationale.

# TCP port the MT5 EA connects to as a plain socket client (NDJSON framing).
# Must match InpBridgePort in XAU_Trader.mq5.
EA_TCP_PORT=9443

# HTTP port serving the browser-facing WebSocket (/ws) and /status. This is
# NOT the port the browser is pointed at — see WEB_PORT below.
HTTP_PORT=8787

# Port the packaged build's spawned Next.js web server listens on — the one
# actually opened in the browser (see Bridge/LaunchButton.mqh's InpWebPort,
# which must match). Unused in dev (apps/web runs its own `next dev`).
WEB_PORT=8788

# Path to the SQLite database file. Defaults to ./data/xautrader.db (relative
# to the bridge process's working directory) when unset — fine for dev; the
# packaged build should point this at a per-OS app-data directory.
# DB_PATH=./data/xautrader.db

# debug | info | warn | error
LOG_LEVEL=info
